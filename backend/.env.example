# SAP Knowledge Assistant Configuration

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sap_assistant

# JWT Security
JWT_SECRET=sap-super-secret-jwt-key-2026-production-ready
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Developer / Admin Secret Key for Ingestion
ADMIN_API_KEY=sap-admin-dev-secret-key-999

# LLM Provider Options: 'openai', 'groq', or 'local'
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# RAG & Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
TOP_K=10
RERANK_TOP_K=4
SIMILARITY_THRESHOLD=0.60
GROUNDING_THRESHOLD=0.65
DOCUMENT_MATCH_THRESHOLD=0.80
AUTO_MULTI_SOURCE_FALLBACK=True
ANSWER_TEMPERATURE=0.10

# Web Fallback
WEB_FALLBACK_ENABLED=True
WEB_SEARCH_API_KEY=
# Maximum relevant Tavily images included only for explicit visual requests.
TAVILY_MAX_IMAGES=4

# GitHub Repository Retrieval & Multi-Source Comparison (Default FALSE)
REPO_SOURCE_ENABLED=false
MULTI_SOURCE_COMPARE_ENABLED=false

# Extended Official SAP Web & Community Sources (Default FALSE)
SAP_WEB_SOURCES_ENABLED=false
